<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="LosslessSwitcher Terminology">
    <suite name="LS Suite" code="sdse" description="Standard commands for this application">
        <command name="get latest sample rate" code="getlrate" description="returns the last known sample rate">
            <cocoa class="LosslessSwitcher.ScriptableApplicationCommand"/>
            <result type="integer" description="sample rate"/>
        </command>
        <command name="get source sample rate" code="getlsrce" description="returns the detected source rate in Hz, or -1 when unknown">
            <cocoa class="LosslessSwitcher.SourceSampleRateCommand"/>
            <result type="integer" description="source sample rate"/>
        </command>
        <command name="get source bit depth" code="getlsbit" description="returns the source bit depth, or -1 when unavailable">
            <cocoa class="LosslessSwitcher.SourceBitDepthCommand"/>
            <result type="integer" description="source bit depth"/>
        </command>
        <command name="get output bit depth" code="getlobit" description="returns the hardware output bit depth, or -1 when unknown">
            <cocoa class="LosslessSwitcher.OutputBitDepthCommand"/>
            <result type="integer" description="output bit depth"/>
        </command>
        <command name="read current track from Music" code="getlrfrs" description="asynchronously reads the current Music rate and may request Automation permission; query the source rate after completion">
            <cocoa class="LosslessSwitcher.ReadCurrentTrackCommand"/>
        </command>
    </suite>
</dictionary>
